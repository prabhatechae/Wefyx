[Unit]
Description=Wefyx IT Support Platform
After=network.target

[Service]
Type=simple
User=wefyx
WorkingDirectory=/opt/wefyx
EnvironmentFile=/opt/wefyx/wefyx.env
ExecStart=/usr/bin/java -jar /opt/wefyx/wefyx-platform-1.0.0.jar
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
